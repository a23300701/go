---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout titulo="GomiFyles y su Almacen" sinMarco>
	<div class="min-h-screen flex flex-col items-center justify-center text-center px-6">
		<h1 class="text-4xl mb-4">Bienvenido a los Archivos de las Gomitas</h1>
		<p class="max-w-md mb-8 texto-suave">
			Aquí vas a encontrar de todo. Advertencia: es muy probable que no quieras volver a salir de lo obsesionado que te vas a poner.
		</p>
		<a href="/tienda" class="boton px-6 py-3">Ir a comprar</a>
	</div>
</BaseLayout>
